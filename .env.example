# Token del bot de Telegram, obtenido a través de @BotFather
TELEGRAM_BOT_TOKEN=

# Chat al que se envían los avisos. Si no lo conoces, arranca el bot sin esta
# variable, escríbele /start y te dirá cuál es.
TELEGRAM_CHAT_ID=

# Conexión a la Postgres de work-from-home. Dentro de Docker, usa el nombre del
# contenedor (work-from-home-postgres). Mejor con un usuario de solo lectura.
DATABASE_URL=postgresql://USUARIO:PASSWORD@work-from-home-postgres:5432/BASE_DE_DATOS

# Persona a vigilar: indica UNA de las dos.
# - TARGET_USER_ID: users.id (uuid) en la Postgres de work-from-home.
# - TARGET_ORACLE_EMP_ID: TEMPLEADOS.EMP_ID en Oracle (users.oracle_emp_id).
TARGET_USER_ID=
# Ignacio Vera Álvarez = EMP_ID 44 en TEMPLEADOS (TIMERTASK_ES)
TARGET_ORACLE_EMP_ID=44

# Nombre que aparece en los mensajes
TARGET_NAME=Ignacio Vera

# Opcionales
# STATE_FILE=data/state.json
# POLL_INTERVAL_MINUTES=5

# Solo para docker-compose: red de Docker donde está la Postgres de work-from-home
# WFH_NETWORK=work-from-home_default
